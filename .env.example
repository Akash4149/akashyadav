PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# 1. DATABASE: MONGODB ATLAS
# -----------------------------------------------------------------------------
# Create a free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/tesla_portfolio?retryWrites=true&w=majority
MONGO_URI=

# -----------------------------------------------------------------------------
# 2. EMAIL NOTIFICATIONS: NODEMAILER (Gmail / SMTP)
# -----------------------------------------------------------------------------
# To send alerts to your email whenever a visitor submits an inquiry:
# For Gmail:
#   1. Enable 2-Step Verification on your Google Account
#   2. Generate an "App Password" at https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password into EMAIL_PASS
EMAIL_SERVICE=gmail
EMAIL_USER=akashyadav9871091290@gmail.com
EMAIL_PASS=your_16_char_app_password
NOTIFICATION_RECEIVER_EMAIL=akashyadav9871091290@gmail.com

# -----------------------------------------------------------------------------
# 3. PHONE SMS NOTIFICATIONS: TWILIO
# -----------------------------------------------------------------------------
# To receive an instant SMS / text on your mobile phone:
# Sign up at https://www.twilio.com (free trial available)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
NOTIFICATION_PHONE_NUMBER=+917827505869
